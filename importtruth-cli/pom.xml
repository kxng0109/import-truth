<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.kxng0109</groupId>
    <artifactId>importtruth</artifactId>
    <version>0.5.0</version>
  </parent>

  <artifactId>importtruth-cli</artifactId>
  <name>importtruth-cli</name>
  <description>Composition root. Owns Main. Builds the shaded JAR.</description>

  <properties>
    <!--
      GraalVM native-image build tooling. The version was read from Maven
      Central on 2026-10-20: the metadata reports latest and release both
      1.1.16. The plugin is declared inside a profile, so the default
      build never resolves it and never needs it on the network.
    -->
    <native.maven.plugin.version>1.1.16</native.maven.plugin.version>
    <!--
      Maximum heap of the native image, in bytes.

      native-image sizes the image heap ergonomically by default:
      -H:MaxHeapSize defaults to 0, which means "80 percent of physical
      memory" (-H:MaximumHeapSizePercent=80), so on a 16 GB machine the
      image heap may grow to several gigabytes. The image's collector
      does not hand memory back to the operating system eagerly, so the
      resident set stays at the high-water mark. Capping the heap makes
      the collector work harder and keeps the footprint at the real
      working set.

      Measured on this machine with the same harness: 76.42 MB peak
      working set with no cap, 46.14 MB with this cap.
    -->
    <native.heap.max.bytes>67108864</native.heap.max.bytes>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.kxng0109</groupId>
      <artifactId>importtruth-mcp</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.kxng0109</groupId>
      <artifactId>importtruth-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.kxng0109</groupId>
      <artifactId>importtruth-index</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.kxng0109</groupId>
      <artifactId>importtruth-adapter-java</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.kxng0109</groupId>
      <artifactId>importtruth-policy</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <forkCount>2</forkCount>
          <reuseForks>true</reuseForks>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.github.kxng0109.importtruth.cli.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Native executable build. Active only with -Pnative, so the default
      build stays exactly as it is: the shaded JAR remains the artifact
      and the GraalVM plugin is never resolved.

      The shaded JAR is the image input. The plugin's default classpath
      would be the artifact plus every runtime dependency, and the shaded
      JAR already contains them.

      The image flags live in
      src/main/resources/META-INF/native-image/io.github.kxng0109/importtruth/native-image.properties
      so that a direct native-image call and this profile build the same
      image. They are repeated here with identical values; GraalVM keeps
      the last value it sees for a repeated option, so the repetition is
      harmless.
    -->
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <version>${native.maven.plugin.version}</version>
            <executions>
              <execution>
                <id>build-native</id>
                <goals>
                  <goal>compile-no-fork</goal>
                </goals>
                <phase>package</phase>
              </execution>
            </executions>
            <configuration>
              <mainClass>io.github.kxng0109.importtruth.cli.Main</mainClass>
              <imageName>importtruth</imageName>
              <classpath>
                <param>${project.build.directory}/${project.build.finalName}.jar</param>
              </classpath>
              <useArgFile>false</useArgFile>
              <buildArgs>
                <buildArg>-O2</buildArg>
                <buildArg>--no-fallback</buildArg>
                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                <buildArg>-H:MaxHeapSize=${native.heap.max.bytes}</buildArg>
              </buildArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
